{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Provider": {
    "Mode": "Success",
    "DelaySeconds": 3
  },
  "Processing": {
    "PollIntervalSeconds": 1,
    "LeaseSeconds": 30,
    "TimeoutSeconds": 5,
    "MaxAttempts": 3
  }
}
